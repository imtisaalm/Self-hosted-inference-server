# Model and API configuration
MODEL=Qwen/Qwen3-0.6B
SERVED_MODEL_NAME=local-model
HOST=0.0.0.0
PORT=8000

# Memory and scheduler configuration
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=64
# Optional scheduler token budget. Leave unset to use vLLM's engine default.
MAX_NUM_BATCHED_TOKENS=
KV_CACHE_DTYPE=auto
ENABLE_PREFIX_CACHING=1

# Parallelism
TENSOR_PARALLEL_SIZE=1

# Optional authentication for /v1, /v2, and /inference endpoints.
# This is not perimeter security; place the server behind a trusted network
# boundary or reverse proxy on untrusted networks.
VLLM_API_KEY=
